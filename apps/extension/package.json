{
  "name": "@snappin/extension",
  "description": "Invoices from various vendors portal downloaded automatically",
  "author": "Mani <mani@snappinapp.com>",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:extension": "infisical run -- wxt",
    "dev:firefox": "infisical run -- wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@clerk/chrome-extension": "^3.1.2",
    "@snappin/apps": "workspace:*",
    "@snappin/env": "workspace:*",
    "@snappin/features": "workspace:*",
    "@snappin/lib": "workspace:*",
    "@snappin/shared": "workspace:*",
    "@snappin/ui": "workspace:*",
    "@tanstack/react-query": "^5.90.19",
    "@trpc/client": "^11.8.1",
    "@trpc/react-query": "^11.8.1",
    "@trpc/server": "^11.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@snappin/typescript-config": "workspace:*",
    "@tailwindcss/vite": "^4.2.1",
    "@types/chrome": "^0.1.37",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "wxt": "^0.20.18"
  }
}
