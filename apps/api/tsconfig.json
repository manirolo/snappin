{
  "extends": "@snappin/typescript-config/base.json",
  "compilerOptions": {
    "module": "CommonJS",
     "moduleResolution": "node",  
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "outDir": "./dist",
    "rootDir": "src"
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}