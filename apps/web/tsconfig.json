{
  "extends": "@snappin/typescript-config/nextjs.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@snappin/web": ["./src/*"],
      "@snappin/features/invoices/*": ["../../packages/features/invoice/*"],
      "@snappin/features/*": ["../../packages/features/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "next.config.js",
    ".next/types/**/*.ts",  ],
  "exclude": [
    "node_modules"
  ]
}
