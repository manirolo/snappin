{
  "name": "@snappin/web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "infisical run -- next dev --port 3000",
    "openapi:gen": "node scripts/openapi.ts > openapi.json",
    "sdk:gen": "openapi-typescript openapi.json -o src/sdk/types.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "check-types": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@clerk/elements": "catalog:",
    "@clerk/nextjs": "catalog:",
    "@hugeicons-pro/core-stroke-rounded": "^3.1.0",
    "@hugeicons-pro/core-bulk-rounded": "^3.1.0",
    "@hugeicons/react": "^1.1.4",
    "@iconify/react": "^6.0.2",
    "@snappin/api": "workspace:*",
    "@snappin/env": "workspace:*",
    "@snappin/features": "workspace:*",
    "@snappin/lib": "workspace:*",
    "@snappin/apps": "workspace:*",
    "@snappin/shared": "workspace:*",
    "@snappin/ui": "workspace:*",
    "@trpc/server": "^11.8.1",
    "http-status-codes": "^2.3.0",
    "next": "catalog:",
    "next-themes": "catalog:",
    "nprogress": "0.2.0",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@snappin/eslint-config": "workspace:*",
    "@snappin/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/nprogress": "^0.2.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
