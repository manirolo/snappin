{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env"],
      "env": [
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
        "CLERK_SECRET_KEY",
        "OPEN_API_KEY",
        "NEXT_PUBLIC_CLERK_SIGN_IN_URL",
        "NEXT_PUBLIC_CLERK_SIGN_UP_URL",
        "CLERK_WEBHOOK_SIGNING_SECRET",
        "SENTRY_DNS",
        "GOOGLE_WORKER_URL",
        "GOOGLE_CLOUD_TASK_QUEUE",
        "GOOGLE_TASK_PUB_SUB_TOPIC",
        "GOOGLE_TASK_SERVICE_ACCOUNT_EMAIL",
        "DB_URL",
        "PORT",
        "NEXT_PUBLIC_ENV",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_WORKER_URL",
        "NEXT_PUBLIC_PORT",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GOOGLE_PROJECT_ID",
        "GOOGLE_SERVICE_KEY",
        "GOOGLE_INVOICE_EXTRACTOR_ID",
        "GOOGLE_REGION",
        "AWS_REGION",
        "AWS_SECRET_ACCESS_KEY",
        "AWS_ACCESS_KEY_ID",
        "MS_CLIENT_ID",
        "MS_CLIENT_SECRET",
        "MS_TENANT_ID",
        "NEXT_PUBLIC_LOGO_DEV_PUBLIC_KEY",
        "WXT_CLERK_PUBLISHABLE_KEY",
        "CLERK_FRONTEND_API",
        "WXT_APP_URL",
        "XERO_CLIENT_ID",
        "XERO_CLIENT_SECRET",
        "ENCRYPTION_SECRET",
        "WHATSAPP_APP_SECRET",
        "WHATSAPP_VERIFY_TOKEN",
        "WHATSAPP_PHONE_NUMBER_ID",
        "WA_APP_SECRET"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".eslintrc.*",
        "eslint.config.*",
        "tsconfig.*"
      ]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false
    },
    "env": {
      "cache": false
    },
    "dev:extension": {
      "cache": false
    },
    "dev:trigger": {
      "cache": false
    },
    "deploy:trigger": {
      "cache": false
    }
  },
  "envMode": "loose",
  "globalEnv": ["NEXT_RUNTIME"]
}
