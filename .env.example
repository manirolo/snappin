# Clerk
#
# Clerk environment variables
# Clerk provides authentication and user management services.
# Obtain your API keys from the Clerk dashboard at https://dashboard.clerk.com/~/api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=

# Database
#
# Snappin uses mongodb for database management
DB_URL=

# Application Environment
#
# Environment must be equal to `development` or `staging` or `production`. Default set to `development` inside source code
ENV=development
URL=http://localhost:3000

# Google
# 
# Google credentials used for obtain tokens (refresh, access) those could be used to read emails
# Visit https://console.cloud.google.com/auth/clients to obtain client id, client secret
# 1. Go to https://console.cloud.google.com/auth/clients
# 2. Login / Sign up your account
# 3. Click on "Create client"
# 4. Select "Web application"
# 5. Enter Application name
# 6. TODO: Add recommended redirect urls
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Hugeicons
# 
# Hugeicons is a icon library
HUGEICONS_LICENSE_KEY=

# AWS
# 
# Amazon web service for data extraction from invoice receipts
AWS_REGION=
AWS_SECRET_ACCESS_KEY=
AWS_ACCESS_KEY_ID=