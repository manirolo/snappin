{
  "extends": "@snappin/typescript-config/nextjs.json",
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "target": "ES2017",
    "module": "preserve",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "paths": {
      "@snappin/db/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
