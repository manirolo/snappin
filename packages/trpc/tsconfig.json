{
  "extends": "@snappin/typescript-config/internal-package.json",
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "baseUrl": ".",
    "rootDir": ".",
    "paths": {
      "@snappin/shared/*": ["./src/*"],
      "@snappin/trpc/*": [
        "./*"
      ]
    }
  },
  "include": ["."],
  "exclude": ["node_modules", "dist"]
}