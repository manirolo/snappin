{
  "extends": "@snappin/typescript-config/nextjs.json",
  "compilerOptions": {
    "target": "ES2017",
    "rootDir": ".",
    "ignoreDeprecations": "5.0",
    "outDir": "dist",
    "resolveJsonModule": true,
    "paths": {
      "@snappin/features/*": ["./*"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": [".", "trigger.config.ts"],
  "exclude": ["node_modules", "dist", "build"]
}
