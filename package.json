{
  "name": "snappin",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "env": "node env.ts",
    "dev:trigger": "infisical run -- trigger dev",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@snappin/typescript-config": "workspace:*",
    "prettier": "^3.7.4",
    "turbo": "^2.7.3",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "mongodb": "7.2.0"
    }
  },
  "dependencies": {
    "@lemonsqueezy/lemonsqueezy.js": "catalog:",
    "framer-motion": "^12.31.0"
  }
}
