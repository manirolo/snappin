{
  "name": "snappin",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "env": "node env.ts",
    "dev:trigger": "infisical run -- trigger dev",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
